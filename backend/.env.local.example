# BeyondC Environment Variables

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# App URL (for callbacks)
NEXT_PUBLIC_APP_URL=https://beyondc.in

# Resend Email
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@beyondc.in
RESEND_FROM_NAME=BeyondC
RESEND_WAITLIST_FROM=BeyondC <onboarding@resend.dev>

# Email provider switch: resend | gmail_smtp
EMAIL_PROVIDER=resend

# Gmail SMTP (for domain-less testing)
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
GMAIL_FROM_EMAIL=
GMAIL_FROM_NAME=BeyondC

# Waitlist -> Google Sheets (Apps Script Web App URL)
WAITLIST_GOOGLE_SCRIPT_URL=
# Optional shared secret header sent as x-waitlist-secret
WAITLIST_WEBHOOK_SECRET=
